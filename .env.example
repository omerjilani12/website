# Namecheap Private Email (mailbox that sends and receives the enquiries)
EMAIL_USERNAME=you@yourdomain.com
EMAIL_PASSWORD=your-mailbox-password

# Optional. Defaults shown.
# EMAIL_HOST=mail.privateemail.com
# EMAIL_PORT=465          # 465 = SSL, 587 = STARTTLS
# CONTACT_TO=             # where enquiries land; defaults to EMAIL_USERNAME
