# ─────────────────────────────────────────────────────────────────────
# Copy to .env.local and fill in. Set the same values on your host.
# ─────────────────────────────────────────────────────────────────────

# REQUIRED. The mailbox the website signs in as to send mail.
# A real Namecheap Private Email mailbox on your own domain, not an alias
# and not a Gmail address. Without these two the form returns an error and
# tells visitors to use WhatsApp instead.
EMAIL_USERNAME=website@yourdomain.com
EMAIL_PASSWORD=your-mailbox-password

# Where enquiries are delivered. Falls back to ENQUIRIES_TO in
# app/api/contact/route.ts when unset.
CONTACT_TO=

# Optional. Defaults shown, so leave commented unless your host differs.
# EMAIL_HOST=mail.privateemail.com
# EMAIL_PORT=465          # 465 = SSL (default), 587 = STARTTLS
